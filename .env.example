# Contact forms → DynamoDB table `blue-iq-contacts-form` (us-east-2)
CONTACTS_TABLE=blue-iq-contacts-form
CONTACTS_REGION=us-east-2
# AWS credentials: use the host's IAM role, or set these for an IAM user that can
# dynamodb:PutItem + dynamodb:Query on the table and its email-index.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Signs the anti-spam form token. Any long random string. Required in production.
CONTACT_FORM_SECRET=

# Extra origins allowed to post (https://*.blue-iq.ai is always allowed), comma-separated
# CONTACT_ALLOWED_ORIGINS=https://app.example.com

# Optional: Cloudflare Turnstile. Set both to turn the challenge on.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
